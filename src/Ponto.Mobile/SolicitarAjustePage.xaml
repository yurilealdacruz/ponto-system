<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ponto.Mobile.SolicitarAjustePage"
             Title="Solicitar Ajuste"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}">

    <VerticalStackLayout Padding="20" Spacing="20">
        <Label Text="Solicitar Ajuste de Ponto" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
        <Label Text="Preencha os dados abaixo para enviar a solicitação ao RH." FontSize="14" TextColor="{AppThemeBinding Light=Gray, Dark=#CCCCCC}" HorizontalOptions="Center" />

        <Border Padding="15" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E1E}" Stroke="Transparent">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="15">

                <Label Text="Data Sugerida:" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                <DatePicker x:Name="DataAjustePicker" Format="dd/MM/yyyy" TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                <Label Text="Qual ponto deseja ajustar?" FontAttributes="Bold" Margin="0,10,0,5" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                <Border Stroke="{AppThemeBinding Light=LightGray, Dark=#444444}" StrokeThickness="1" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2C2C2C}" Padding="5">
                    <Picker x:Name="PickerTipoPonto" Title="Selecione qual batida..." TextColor="{AppThemeBinding Light=Black, Dark=White}" TitleColor="{AppThemeBinding Light=Gray, Dark=LightGray}">
                        <Picker.Items>
                            <x:String>Entrada 1 (Início do Turno)</x:String>
                            <x:String>Saída 1 (Ida para o Almoço)</x:String>
                            <x:String>Entrada 2 (Volta do Almoço)</x:String>
                            <x:String>Saída 2 (Fim do Turno)</x:String>
                        </Picker.Items>
                    </Picker>
                </Border>

                <Label Text="Hora Correta:" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                <TimePicker x:Name="HoraAjustePicker" Format="HH:mm" TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                <Label Text="Justificativa:" FontAttributes="Bold" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                <Entry x:Name="JustificativaEntry" Placeholder="Ex: Esqueci de bater o ponto na saída" MaxLength="250" TextColor="{AppThemeBinding Light=Black, Dark=White}" PlaceholderColor="{AppThemeBinding Light=Gray, Dark=LightGray}" />

            </VerticalStackLayout>
        </Border>

        <Button x:Name="BtnEnviarSolicitacao" Text="Enviar Solicitação" Clicked="OnEnviarClicked" BackgroundColor="{AppThemeBinding Light=#4B0082, Dark=#6A1B9A}" TextColor="White" CornerRadius="8" HeightRequest="50" />

        <Button Text="Cancelar" Clicked="OnCancelarClicked" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light=Red, Dark=#FF6B6B}" />

    </VerticalStackLayout>
</ContentPage>