<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Ponto.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Ponto.Mobile"
    Shell.FlyoutBehavior="Disabled">

    <TabBar>
        <Tab Title="Bater Ponto">
            <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
        </Tab>
        
        <Tab Title="Histórico">
            <ShellContent ContentTemplate="{DataTemplate local:HistoricoPage}" />
        </Tab>

        <!-- A ABA SECRETA AGORA É UM TAB E FICA AQUI DENTRO -->
        <Tab x:Name="TabAdministracao"
             x:FieldModifier="public"
             Title="Admin" 
             Icon="dotnet_bot.png"
             IsVisible="False">
            <ShellContent ContentTemplate="{DataTemplate local:PainelAdminPage}" />
        </Tab>
    </TabBar>

</Shell>