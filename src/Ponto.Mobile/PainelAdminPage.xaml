<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:res="clr-namespace:Ponto.Mobile.Strings"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ponto.Mobile.PainelAdminPage"
             Title="{x:Static res:AppResources.TitleGestaoEquipe}"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="{x:Static res:AppResources.BtnNovo}" Clicked="OnNovoFuncionarioClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">
        <Label Grid.Row="0" Text="{x:Static res:AppResources.LblColaboradores}" FontSize="22" FontAttributes="Bold" Margin="15" TextColor="{AppThemeBinding Light=Black, Dark=White}" />

        <RefreshView Grid.Row="1" x:Name="RefreshEquipe" Refreshing="OnRefreshEquipe">
            <CollectionView x:Name="ListaEquipe" Margin="15">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,15" Padding="15">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#1E1E1E}" />
                                    <Setter Property="Stroke" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding TemAjustePendente}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFACD, Dark=#2A2400}" />
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light=#FFD700, Dark=#B8860B}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid ColumnDefinitions="*, Auto, Auto">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                    <VerticalStackLayout.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnColaboradorTapped" CommandParameter="{Binding .}" />
                                    </VerticalStackLayout.GestureRecognizers>

                                    <Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="18" TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}" />
                                    <Label Text="{x:Static res:AppResources.LblAjustePendente}" TextColor="{AppThemeBinding Light=#B8860B, Dark=#FFD700}" FontSize="13" FontAttributes="Italic" IsVisible="{Binding TemAjustePendente}" />
                                </VerticalStackLayout>

                                <Button Grid.Column="1" Text="{x:Static res:AppResources.BtnDesativar}" 
                                        BackgroundColor="{AppThemeBinding Light=#DC3545, Dark=#C82333}" TextColor="White" 
                                        FontSize="12" HeightRequest="36" Margin="0,0,10,0"
                                        VerticalOptions="Center"
                                        Clicked="OnDesativarClicked" CommandParameter="{Binding Id}" />

                                <Label Grid.Column="2" Text=">" FontSize="20" TextColor="{AppThemeBinding Light=Gray, Dark=LightGray}" VerticalOptions="Center" FontAttributes="Bold">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnColaboradorTapped" CommandParameter="{Binding .}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="{x:Static res:AppResources.MsgNenhumColaborador}" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{AppThemeBinding Light=Gray, Dark=#CCCCCC}" />
                </CollectionView.EmptyView>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>