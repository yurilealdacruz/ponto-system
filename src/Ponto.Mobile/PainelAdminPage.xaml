<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ponto.Mobile.PainelAdminPage"
             Title="Gestão de Equipe"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,*">
        <Label Grid.Row="0" Text="Colaboradores" FontSize="22" FontAttributes="Bold" Margin="15" />

        <RefreshView Grid.Row="1" x:Name="RefreshEquipe" Refreshing="OnRefreshEquipe">
            <CollectionView x:Name="ListaEquipe" Margin="15">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- O CommandParameter passa os dados do funcionário clicado para o C# -->
                        <Border Margin="0,0,0,15" Padding="20">

                            <!-- Borda arredondada -->
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>

                            <!-- A Mágica da Cor: DataTrigger -->
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BackgroundColor" Value="White" />
                                    <Setter Property="Stroke" Value="Transparent" />
                                    <Style.Triggers>
                                        <!-- Se TemAjustePendente for True, muda para Amarelo -->
                                        <DataTrigger TargetType="Border" Binding="{Binding TemAjustePendente}" Value="True">
                                            <Setter Property="BackgroundColor" Value="#FFFACD" />
                                            <Setter Property="Stroke" Value="#FFD700" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <!-- Detecta o clique no card inteiro -->
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnColaboradorTapped" CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                    <Label Text="{Binding Nome}" FontAttributes="Bold" FontSize="18" TextColor="#333333" />

                                    <!-- Esta mensagem extra só aparece se houver pendência -->
                                    <Label Text="Ajuste Pendente" TextColor="#B8860B" FontSize="13" FontAttributes="Italic" IsVisible="{Binding TemAjustePendente}" />
                                </VerticalStackLayout>

                                <!-- Ícone de seta apontando para a direita -->
                                <Label Grid.Column="1" Text=">" FontSize="24" TextColor="Gray" VerticalOptions="Center" FontAttributes="Bold" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="Nenhum colaborador encontrado." HorizontalOptions="Center" VerticalOptions="Center" TextColor="Gray" />
                </CollectionView.EmptyView>

            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>