<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ponto.Mobile.DetalhesColaboradorPage"
             BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#121212}">

    <Grid RowDefinitions="Auto, *">

        <StackLayout Padding="15" Spacing="10">
            <Label Text="Exportar Espelho de Ponto" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light=Black, Dark=White}" />

            <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                <!-- Picker de Mês -->
                <Picker x:Name="PickerMes" Title="Selecione o Mês" Grid.Column="0" TextColor="{AppThemeBinding Light=Black, Dark=White}" TitleColor="{AppThemeBinding Light=Gray, Dark=LightGray}">
                    <Picker.Items>
                        <x:String>Janeiro</x:String>
                        <x:String>Fevereiro</x:String>
                        <x:String>Março</x:String>
                        <x:String>Abril</x:String>
                        <x:String>Maio</x:String>
                        <x:String>Junho</x:String>
                        <x:String>Julho</x:String>
                        <x:String>Agosto</x:String>
                        <x:String>Setembro</x:String>
                        <x:String>Outubro</x:String>
                        <x:String>Novembro</x:String>
                        <x:String>Dezembro</x:String>
                    </Picker.Items>
                </Picker>

                <!-- Picker de Ano -->
                <Picker x:Name="PickerAno" Title="Ano" Grid.Column="1" TextColor="{AppThemeBinding Light=Black, Dark=White}" TitleColor="{AppThemeBinding Light=Gray, Dark=LightGray}">
                    <Picker.Items>
                        <x:String>2025</x:String>
                        <x:String>2026</x:String>
                    </Picker.Items>
                </Picker>
            </Grid>

            <Button Text="Baixar Relatório PDF" 
                    BackgroundColor="{AppThemeBinding Light=#4A148C, Dark=#6A1B9A}" 
                    TextColor="White" 
                    Clicked="OnGerarPdfAdminClicked" />
        </StackLayout>

        <!-- CARTÃO DE AJUSTE PENDENTE (Oculto por padrão) -->
        <ContentView x:Name="ContainerPendencia" Grid.Row="0" IsVisible="False" Padding="15,15,15,0">
            <Border BackgroundColor="{AppThemeBinding Light=#FFFACD, Dark=#2A2400}" 
                    Stroke="{AppThemeBinding Light=#FFD700, Dark=#B8860B}" 
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="5">
                    <Label Text="Solicitação de Ajuste Pendente" FontAttributes="Bold" FontSize="16" TextColor="{AppThemeBinding Light=#B8860B, Dark=#FFD700}" />
                    <Label x:Name="LabelDataSugerida" TextColor="{AppThemeBinding Light=#333333, Dark=#E0E0E0}" FontAttributes="Bold" />
                    <Label x:Name="LabelJustificativa" TextColor="{AppThemeBinding Light=Gray, Dark=#CCCCCC}" FontAttributes="Italic" />

                    <Button x:Name="BtnAprovar" 
                            Text="Aprovar Ajuste" 
                            BackgroundColor="Green" 
                            TextColor="White" 
                            CornerRadius="8" 
                            Margin="0,10,0,0"
                            Clicked="OnAprovarClicked" />
                </VerticalStackLayout>
            </Border>
        </ContentView>

        <!-- HISTÓRICO DO COLABORADOR -->
        <VerticalStackLayout Grid.Row="1" Padding="15">
            <Label Text="Histórico de Ponto" FontSize="18" FontAttributes="Bold" Margin="0,10,0,10" TextColor="{AppThemeBinding Light=Black, Dark=White}" />

            <CollectionView x:Name="ListaHistorico">
                <CollectionView.Header>
                    <Grid ColumnDefinitions="1.5*, 1*, 1*, 1*, 1*, 40" Padding="0,0,0,10">
                        <Label Text="Data" FontAttributes="Bold" Grid.Column="0" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        <Label Text="Ent 1" FontAttributes="Bold" Grid.Column="1" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        <Label Text="Sai 1" FontAttributes="Bold" Grid.Column="2" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        <Label Text="Ent 2" FontAttributes="Bold" Grid.Column="3" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                        <Label Text="Sai 2" FontAttributes="Bold" Grid.Column="4" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                    </Grid>
                </CollectionView.Header>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="1.5*, 1*, 1*, 1*, 1*, 40" Padding="0,12" VerticalOptions="Center">
                            <Label Text="{Binding DataFormatada}" Grid.Column="0" VerticalOptions="Center" TextColor="{AppThemeBinding Light=Gray, Dark=#CCCCCC}" FontSize="13" />
                            <Label Text="{Binding Ponto1}" Grid.Column="1" HorizontalOptions="Center" VerticalOptions="Center" FontSize="13" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                            <Label Text="{Binding Ponto2}" Grid.Column="2" HorizontalOptions="Center" VerticalOptions="Center" FontSize="13" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                            <Label Text="{Binding Ponto3}" Grid.Column="3" HorizontalOptions="Center" VerticalOptions="Center" FontSize="13" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                            <Label Text="{Binding Ponto4}" Grid.Column="4" HorizontalOptions="Center" VerticalOptions="Center" FontSize="13" TextColor="{AppThemeBinding Light=Black, Dark=White}" />

                            <!-- Botão de Mapa dentro da linha, apontando para a classe DiaTrabalho -->
                            <Button Grid.Column="5" 
                                    Text="📍" 
                                    BackgroundColor="Transparent" 
                                    TextColor="#17A2B8" 
                                    Padding="0" 
                                    FontSize="16"
                                    HeightRequest="30"
                                    WidthRequest="30"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    CommandParameter="{Binding .}" 
                                    Clicked="OnAbrirMapaDiaClicked" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

    </Grid>
</ContentPage>