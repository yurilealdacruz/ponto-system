<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:res="clr-namespace:Ponto.Mobile.Strings"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Ponto.Mobile.LoginPage"
             Title="Login">

    <VerticalStackLayout Spacing="20" Padding="30" VerticalOptions="Center">

        <!-- Traduzindo o Título -->
        <Label Text="{x:Static res:AppResources.TxtBemVindo}" FontSize="32" HorizontalOptions="Center" FontAttributes="Bold" Margin="0,0,0,30" />

        <!-- Traduzindo o Placeholder (mantendo o x:Name estático para o C# usar) -->
        <Entry x:Name="IdentificadorEntry" 
               Placeholder="{x:Static res:AppResources.PhIdentificador}" 
               Keyboard="Text" />

        <Entry x:Name="SenhaEntry" 
               Placeholder="{x:Static res:AppResources.PhSenha}" 
               IsPassword="True" />

        <!-- O Botão já estava correto! -->
        <Button Text="{x:Static res:AppResources.BtnEntrar}" 
                Clicked="OnLoginClicked" 
                BackgroundColor="#512BD4" 
                TextColor="White" 
                CornerRadius="8" 
                Margin="0,20,0,0" />

    </VerticalStackLayout>
</ContentPage>